{
  "name": "registre",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "description": "REGISTRE — poste de commandement BTS Comptabilité et Gestion",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit false --emitDeclarationOnly false || tsc -b",
    "notion:sync": "node scripts/notion-sync.mjs",
    "notion:sync:dry": "node scripts/notion-sync.mjs --dry-run",
    "build:pages": "tsc -b && vite build --mode pages",
    "build:fichier": "tsc -b && vite build --mode fichier && node scripts/build-fichier-unique.mjs"
  },
  "dependencies": {
    "@react-three/drei": "^9.114.0",
    "@react-three/fiber": "^8.17.10",
    "date-fns": "^4.1.0",
    "gsap": "^3.12.5",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "three": "^0.169.0",
    "zustand": "^5.0.1"
  },
  "devDependencies": {
    "@notionhq/client": "^2.2.15",
    "@tailwindcss/vite": "^4.0.0",
    "@types/node": "^22.9.0",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@types/three": "^0.169.0",
    "@vitejs/plugin-react": "^4.3.3",
    "dotenv": "^16.4.5",
    "tailwindcss": "^4.0.0",
    "typescript": "^5.6.3",
    "vite": "^5.4.10"
  }
}
