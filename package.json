{
  "name": "billable-hours",
  "version": "0.1.0",
  "private": true,
  "description": "Billable Hours — jeu narratif immersif dans un cabinet d'avocats d'affaires de Manhattan (Harlow & Vance).",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "predev": "node tools/build-manifest.mjs",
    "prebuild": "node tools/build-manifest.mjs",
    "assets:manifest": "node tools/build-manifest.mjs",
    "assets:depth": "python3 tools/depth.py",
    "voices:csv": "node --experimental-strip-types --no-warnings tools/export-voices.mts"
  },
  "dependencies": {
    "@react-three/fiber": "^9.8.0",
    "@react-three/postprocessing": "^3.1.2",
    "gsap": "^3.15.0",
    "next": "^15.5.26",
    "postprocessing": "^6.39.5",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "three": "^0.186.0",
    "zustand": "^5.0.15"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.7",
    "@tailwindcss/postcss": "^4.3.3",
    "@types/node": "^22.20.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "eslint": "^9.39.5",
    "eslint-config-next": "^15.5.26",
    "postcss": "^8.5.28",
    "tailwindcss": "^4.3.3",
    "typescript": "5.9",
    "vitest": "^3.2.7"
  }
}
