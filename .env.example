# ---------------------------------------------------------------------------
# REGISTRE — configuration Notion (utilisée uniquement par scripts/notion-sync.mjs)
# Copie ce fichier en `.env` puis remplis les deux valeurs.
# ---------------------------------------------------------------------------

# Jeton d'intégration interne Notion (commence par "ntn_" ou "secret_").
# https://www.notion.so/profile/integrations  ->  Nouvelle intégration
NOTION_TOKEN=ntn_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ID de la page Notion qui accueillera la base « BTS CG — Cours ».
# C'est le bloc de 32 caractères dans l'URL de la page :
# https://www.notion.so/Mon-espace-BTS-1a2b3c4d5e6f7890abcdef1234567890
NOTION_PARENT_PAGE_ID=1a2b3c4d5e6f7890abcdef1234567890
