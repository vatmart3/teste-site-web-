# Clé API Anthropic. Serveur uniquement, jamais exposée au client.
ANTHROPIC_API_KEY=sk-ant-...

# Modèle utilisé pour la conversion. Par défaut : claude-sonnet-5
ANTHROPIC_MODEL=claude-sonnet-5

# Effort de raisonnement : low | medium | high | xhigh | max
# low = le plus rapide, c'est le réglage qui tient la promesse des 20 s.
ANTHROPIC_EFFORT=low

# Nombre de conversions gratuites par jour et par IP.
FICHE_FREE_QUOTA=3
